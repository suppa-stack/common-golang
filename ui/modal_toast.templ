package ui

import "fmt"

// ModalToastContainer renders the stable target used by ui.toast SSE events
// whose scope is a modal. Keep the toast-<modalID> identifier in sync with the
// common frontend event handler.
templ ModalToastContainer(modalID string) {
	<div id={ fmt.Sprintf("toast-%s", modalID) } class="toast toast-top toast-end z-[1000]" data-modal-id={ modalID } x-data="modalToastContainer">
		<template x-for="toast in toasts" :key="toast.id">
			@toastCard()
		</template>
	</div>
}
